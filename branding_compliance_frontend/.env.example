# PUBLIC_INTERFACE
# Base URL for the backend API. Should point to the FastAPI v1 prefix.
# For local development:
REACT_APP_API_BASE=http://localhost:3001/api/v1

# For preview deployments, set this to the backend preview URL if not using a proxy:
# REACT_APP_API_BASE=https://<your-backend-preview-host>/api/v1
