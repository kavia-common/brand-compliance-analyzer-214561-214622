# Frontend environment configuration
# IMPORTANT:
# - REACT_APP_API_BASE MUST include /api/v1 and MUST NOT end with a trailing slash.
# - In local dev, the backend typically runs on http://localhost:3001.
# - In preview environments, prefer HTTPS and point to the backend host on port 3001.

# Local development example:
REACT_APP_API_BASE=http://localhost:3001/api/v1

# Preview example (replace <host> with your backend host):
# REACT_APP_API_BASE=https://<host>:3001/api/v1
