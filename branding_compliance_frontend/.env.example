# PUBLIC_INTERFACE
# Example environment variables for the frontend.
# REACT_APP_API_BASE MUST include /api/v1 and MUST NOT end with a trailing slash.
# Local dev:
# REACT_APP_API_BASE=http://localhost:3001/api/v1
# Preview (this project):
# REACT_APP_API_BASE=https://<your-preview-host>:3001/api/v1

REACT_APP_API_BASE=
